<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <SwitchPreferenceCompat android:key="fold_keyboard_enabled" android:title="@string/fold_keyboard_enabled" android:summary="@string/fold_keyboard_summary" android:defaultValue="false" />
    <ListPreference android:key="fold_keyboard_layout" android:title="@string/fold_keyboard_layout" android:defaultValue="SPLIT" android:dependency="fold_keyboard_enabled" app:useSimpleSummaryProvider="true" />
    <PreferenceCategory android:title="@string/split_keyboard_main">
        <ListPreference android:key="split_keyboard_main_type" android:title="@string/split_keyboard_main" android:defaultValue="TENKEY" app:useSimpleSummaryProvider="true" />
        <ListPreference android:key="split_keyboard_main_custom" android:title="@string/split_keyboard_custom" app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/split_keyboard_sub">
        <ListPreference android:key="split_keyboard_sub_type" android:title="@string/split_keyboard_sub" android:defaultValue="TENKEY" app:useSimpleSummaryProvider="true" />
        <ListPreference android:key="split_keyboard_sub_custom" android:title="@string/split_keyboard_custom" app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>
    <ListPreference android:key="split_keyboard_candidates" android:title="@string/split_keyboard_candidates" android:defaultValue="BOTH" app:useSimpleSummaryProvider="true" />
    <ListPreference android:key="split_keyboard_edit_placement" android:title="@string/split_keyboard_edit_placement" android:defaultValue="MAIN" app:useSimpleSummaryProvider="true" />
</PreferenceScreen>
